ACTUAL_SERVER_URL=https://actual.example.local
ACTUAL_SERVER_PASSWORD=replace-with-your-server-password
ACTUAL_SYNC_ID=replace-with-your-budget-sync-id
# Leave empty when end-to-end encryption is disabled.
ACTUAL_ENCRYPTION_PASSWORD=
ACTUAL_DATA_DIR=./data/actual
PORT=3000
HOST=127.0.0.1
# Optional: set this only when the browser frontend is served from another origin.
# Example: https://finance.example.local
CORS_ORIGIN=
APP_TIME_ZONE=America/Sao_Paulo
