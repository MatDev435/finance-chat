# Finance Chat: configuração do servidor (valores de exemplo, todos fictícios).
# As credenciais do Actual Budget NÃO ficam aqui: cada usuário informa as suas
# na tela "Conectar ao Actual Budget", e elas são cifradas no SQLite.

# Chave da aplicação (obrigatória, mínimo 32 caracteres aleatórios).
# Cifra as senhas do Actual salvas no banco e assina as sessões.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Guarde uma cópia segura: sem ela, as conexões salvas precisam ser refeitas.
APP_SECRET=replace-with-a-long-random-secret-generated-by-the-command-above

# Interface e porta HTTP. 127.0.0.1 é o ideal com o Caddy na mesma máquina.
HOST=127.0.0.1
PORT=3000

# Diretório persistente: banco SQLite, caches do Actual por usuário e backups.
# Em produção, use um caminho FORA da pasta do código, como /var/lib/finance-chat.
DATA_DIR=./data

# true quando o Finance Chat está atrás de um reverse proxy (Caddy, nginx).
# Faz o limite de tentativas de login usar o IP real do cliente (X-Forwarded-For).
TRUST_PROXY=false

# Cookies com a flag Secure: auto (detecta HTTPS, inclusive via proxy), true ou false.
COOKIE_SECURE=auto

# Permite novos cadastros depois do primeiro usuário (o primeiro sempre pode se cadastrar).
ALLOW_SIGNUP=false

# Fuso horário usado na data das movimentações e no mês das consultas.
APP_TIME_ZONE=America/Sao_Paulo

# Quantidade de backups mantidos por "npm run backup".
BACKUP_KEEP=14
